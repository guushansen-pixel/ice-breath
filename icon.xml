<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-Icon fuer Ice Breath: ein Eistropfen als Silhouette.
     108x108, Motiv innerhalb von Radius 31 um die Mitte (54,54), damit
     nichts von der runden Launcher-Maske abgeschnitten wird. Schatten
     und Glanzpunkt sind bewusst dunkler/heller statt hintergrundfarben,
     damit das Icon auch bei einer anderen IconBackground-Farbe erkennbar
     bleibt (gleiche Konvention wie bei hopper/interval-timer). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tropfenkoerper -->
    <path android:fillColor="#CFF3F8"
        android:pathData="M54,25 C64,39 72,48 72,60 A18,18 0 1,1 36,60 C36,48 44,39 54,25 Z" />

    <!-- Schattenrundung unten rechts fuer Tiefe -->
    <path android:fillColor="#6FC4D2"
        android:fillAlpha="0.85"
        android:pathData="M65,66 a9,9 0 1,0 0.1,0 z" />

    <!-- Glanzpunkt oben links -->
    <path android:fillColor="#FFFFFF"
        android:fillAlpha="0.9"
        android:pathData="M47,41 a4,4 0 1,0 0.1,0 z" />
</vector>
